# MONGODB_URI: Required. MongoDB connection string used to persist leads.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<database>"

# NVIDIA_API_KEY: Required. Used by the AI Career Assistant (/api/ai) to call
# NVIDIA's hosted mistral-nemotron model.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# ADMIN_PASSWORD: Required. Shared password gating Admin Workspace, the Leads
# Dashboard, and the /api/leads management APIs.
ADMIN_PASSWORD="choose-a-strong-password"

# --- Optional integrations (leads are captured and stored even without these) ---

# WHATSAPP_API_URL / WHATSAPP_API_TOKEN: WhatsApp Business API credentials for
# dispatching new-lead notifications. If unset, notifications are skipped.
# WHATSAPP_API_URL=""
# WHATSAPP_API_TOKEN=""

# NOTIFY_WHATSAPP_NUMBERS: Comma-separated list of numbers to notify on new leads.
# Defaults to the two numbers hardcoded in server.ts if unset.
# NOTIFY_WHATSAPP_NUMBERS="+91XXXXXXXXXX,+91XXXXXXXXXX"

# APPS_SCRIPT_WEBHOOK_URL: Google Apps Script webhook URL to sync new leads to
# an external Google Sheet. If unset, this sync is skipped.
# APPS_SCRIPT_WEBHOOK_URL=""

# DISABLE_HMR: Set to "true" to disable Vite's dev-server hot module reload.
# DISABLE_HMR="false"

# --- Dodo Payments (online payments) ---
# Payments stay disabled (checkout returns "not configured") until these are set.
# Create products in the Dodo Payments dashboard; the price is defined there.

# DODO_PAYMENTS_API_KEY: Secret API key from the Dodo Payments dashboard (server-side only).
# DODO_PAYMENTS_API_KEY="MY_DODO_API_KEY"

# DODO_PAYMENTS_WEBHOOK_KEY: Signing secret of the webhook endpoint you create in
# Dodo (looks like whsec_...). Used to verify every webhook signature.
# DODO_PAYMENTS_WEBHOOK_KEY="MY_DODO_WEBHOOK_SECRET"

# DODO_PAYMENTS_ENVIRONMENT: "test_mode" (default) or "live_mode".
# DODO_PAYMENTS_ENVIRONMENT="test_mode"

# DODO_PRODUCT_ID_WEBINAR: Dodo product id (pdt_...) for the standard webinar pass.
# Plans/Programmes/individual webinars can use their own product via the
# "Dodo Payments Product ID" field in Admin > Programmes & Catalog.
# DODO_PRODUCT_ID_WEBINAR="pdt_XXXXXXXX"

# APP_URL: Public https URL of this site (no trailing slash). Used for the
# payment return/cancel URLs. REQUIRED in production, e.g. https://www.careerbuddies.in
# APP_URL="https://your-domain.example"

# --- Candidate accounts (Login / Sign Up) ---
# CANDIDATE_SESSION_SECRET: Optional. Secret used to sign candidate session tokens.
# If unset, a key is derived from ADMIN_PASSWORD. Set a long random value in production.
# CANDIDATE_SESSION_SECRET="long-random-string"

# --- Social sign-in (Google / LinkedIn / Microsoft / Facebook) ---
# Each provider is enabled only when BOTH of its values are set. Secrets stay server-side.
# Redirect URI to register with each provider: <PUBLIC_BASE_URL>/api/auth/<provider>/callback
#   (provider = google | linkedin | microsoft | facebook)
# PUBLIC_BASE_URL: Public origin of this site, e.g. https://www.example.com (no trailing slash).
# If unset, the origin is taken from the incoming request (handy for local/tunnel testing).
# PUBLIC_BASE_URL=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT: "common" (work/school + personal, default), "organizations", "consumers", or a tenant id.
# MICROSOFT_TENANT="common"
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""

# --- Transactional email (password reset) ---
# Any SMTP provider works. Password-reset emails are sent only when SMTP_HOST and EMAIL_FROM are set.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="CareerBuddies <no-reply@yourdomain.com>"
# Reset links use PUBLIC_BASE_URL (see above); only localhost / trycloudflare origins are accepted without it.
